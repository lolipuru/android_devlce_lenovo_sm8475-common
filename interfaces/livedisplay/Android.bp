filegroup {
    name: "vendor.lineage.livedisplay-lenovo-af",
    srcs: ["AntiFlicker.cpp"],
}

filegroup {
    name: "vendor.lineage.livedisplay-lenovo-se",
    srcs: ["SunlightEnhancement.cpp"],
}

cc_library_headers {
    name: "vendor.lineage.livedisplay-lenovo-headers",
    vendor_available: true,
    export_include_dirs: ["include"],
}

cc_defaults {
    name: "livedisplay_lenovo_defaults",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    srcs: [
        ":vendor.lineage.livedisplay-lenovo-af",
        ":vendor.lineage.livedisplay-lenovo-se",
        ":vendor.lineage.livedisplay-sdm-pa",
        ":vendor.lineage.livedisplay-sdm-utils",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.livedisplay-V1-ndk",
    ],
    header_libs: [
        "vendor.lineage.livedisplay-sdm-headers",
        "vendor.lineage.livedisplay-lenovo-headers",
    ],
}

cc_binary {
    name: "vendor.lineage.livedisplay-service.lenovo",
    vintf_fragments: ["vendor.lineage.livedisplay-service.lenovo.xml"],
    init_rc: ["vendor.lineage.livedisplay-service.lenovo.rc"],
    defaults: ["livedisplay_lenovo_defaults"],
    vendor: true,
}